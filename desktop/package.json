{
  "name": "kanban-app",
  "productName": "Kanban",
  "version": "0.0.0",
  "description": "Kanban desktop client",
  "author": "Akvicor",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Akvicor/kanban-app",
  "desktopName": "kanban-app.desktop",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "dependenciesMeta": {
    "electron": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.0"
}
